# Choose: nvidia, groq, openrouter, or cerebras.
LLM_PROVIDER=nvidia
# Optional role override. Useful when the selected provider's per-minute token
# allowance is too small for the single, comparatively large director plan.
# DIRECTOR_PROVIDER=openrouter

# NVIDIA
NVIDIA_API_KEY=your_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DIRECTOR_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_PLANNER_MODEL=meta/llama-3.1-8b-instruct

# Groq (recommended models for this project)
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DIRECTOR_MODEL=openai/gpt-oss-120b
GROQ_PLANNER_MODEL=openai/gpt-oss-120b
# Provider-specific fast planner override. FAST_PLANNER_MODEL remains available
# as a backward-compatible fallback for every provider.
GROQ_FAST_PLANNER_MODEL=openai/gpt-oss-20b
# FAST_PLANNER_MODEL=your_provider_compatible_model
# Optional after upgrading Groq; otherwise model-specific free limits are used.
# GROQ_TPM_LIMIT=8000
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPD_LIMIT=200000
GROQ_TPM_SAFETY_TOKENS=300
USD_TO_INR_RATE=95.6416
USD_TO_INR_RATE_AS_OF=2026-08-20
USD_TO_INR_RATE_SOURCE=https://www.fexant.com/bank/RBI
# Fail over a stalled visual request so scene 1 becomes playable promptly.
VISUAL_REQUEST_TIMEOUT_SECONDS=12
WORD_TIMESTAMPS_REQUEST_TIMEOUT_SECONDS=8
WORD_TIMESTAMPS_WAIT_SECONDS=12

# OpenRouter (replace these with any compatible OpenRouter model slugs)
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DIRECTOR_MODEL=openai/gpt-oss-120b
OPENROUTER_PLANNER_MODEL=qwen/qwen3.6-27b
OPENROUTER_HTTP_REFERER=http://localhost:5000
OPENROUTER_APP_TITLE=Explainora

# Cerebras (recommended for the director when low latency and a large
# completion allowance are both required)
CEREBRAS_API_KEY=your_cerebras_key_here
CEREBRAS_API_KEYS=csk_extra_key_1,csk_extra_key_2
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_DIRECTOR_MODEL=gpt-oss-120b
CEREBRAS_PLANNER_MODEL=gpt-oss-120b
CEREBRAS_FAST_PLANNER_MODEL=gpt-oss-120b
CEREBRAS_TIMEOUT_SECONDS=30
CEREBRAS_RPM_LIMIT=5
CEREBRAS_RPH_LIMIT=150
CEREBRAS_RPD_LIMIT=2400
CEREBRAS_KEY_WAIT_MAX_SECONDS=70

# Optional: use different providers for each role.
# DIRECTOR_PROVIDER=groq
# PLANNER_PROVIDER=cerebras

# Backward-compatible generic overrides. Provider-specific models above win.
# DIRECTOR_MODEL=your_model_slug
# DIRECTOR_MAX_TOKENS=20000
# DIRECTOR_MIN_TOKENS=8000
# DIRECTOR_TOKENS_PER_NARRATION_WORD=12
# DIRECTOR_PREFLIGHT_REPAIR_ATTEMPTS=2
# PLANNER_MODEL=your_model_slug

# NVIDIA DeepSeek V4 and Groq Qwen 3.6 calls use non-thinking mode.
DIRECTOR_REASONING_EFFORT=none
VISUAL_REASONING_EFFORT=none

# Existing visual engine controls.
PLAN_REVIEW_MODE=off
VISUAL_JSON_LLM_REPAIR_ENABLED=false
DIRECTOR_FACTUALITY_REPAIR_ATTEMPTS=1
# Zero-token local cleanup if the model repair still leaves rejected quantities.
DIRECTOR_FACTUALITY_LOCAL_FALLBACK=true
ICONIFY_PREFIXES=tabler,mdi,ph,lucide

# Duration planning. Match this roughly to your TTS speaking rate.
DIRECTOR_WPM=145
SCENE_SECONDS_TARGET=14
MIN_SCENES=3
MAX_SCENES=30
# Long plans returned with too few scenes are repartitioned from their paired
# narration/visual beats so no static scene must carry more than this target.
MAX_SCENE_HOLD_SECONDS=30
# Accept narration up to this many seconds shorter or longer than requested.
DURATION_TOLERANCE_SECONDS=8
DURATION_ACCEPTANCE_SECONDS=5
DURATION_ACCEPTANCE_RATIO=0.10
MAX_SCRIPT_REVISIONS=3

# Parallelism.
MAX_WORKERS=4
MAX_VISUAL_WORKERS=2
AUTO_SCALE_PROVIDER_WORKERS=true
MAX_PROVIDER_WORKERS=8
# LLM calls remain parallel. This bounds only the local ordered scene-state
# reconciliation if an earlier scene fails to arrive.
CONTINUITY_WAIT_SECONDS=180
# Issue 3 quality-first modes: hybrid | elements | semantic.
# Hybrid restores expressive free-form planning and keeps semantic storyboards
# as an optional shortcut for genuinely structured diagrams.
VISUAL_PLANNING_MODE=hybrid
SEMANTIC_STORYBOARD_ENABLED=false
FOREGROUND_AUTOFRAME_ENABLED=true
FOREGROUND_MAX_SCALE_BOOST=1.35
MIN_VISUAL_FONT_SIZE=16

# Token-free generalized art direction and one consistent on-demand icon set.
GRAPHICS_STYLE_ENABLED=true
GRAPHICS_THEME=editorial
GRAPHICS_ICON_FAMILY=mdi
ICONIFY_STRICT_FAMILY=true
GRAPHICS_FONT_FAMILY=Inter, Segoe UI, Arial, sans-serif

# Local TTS: auto selects Piper when configured, otherwise eSpeak.
TTS_BACKEND=auto
TTS_SPEED_WPM=145
PIPER_LENGTH_SCALE=1.08
PIPER_COLD_START_WPM=178
PIPER_COLD_START_FEATURE_SCALE=0.67
VISUAL_COMPACT_MAX_TOKENS=3600
TTS_VOICE=en-us

# Recommended production-quality local TTS:
# PIPER_BIN=piper
# PIPER_MODEL=/absolute/path/to/en_US-lessac-medium.onnx

# Video.
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_CRF=20
PORT=5000

# ---- Real-time streaming mode (new in v2) ----
# 1 = POST /api/videos uses the streaming pipeline by default
# (mode="streaming"). Set 0 to keep the original batch behavior unless the
# client explicitly requests mode="streaming".
USE_STREAMING=1

# Duration calibration: fits seconds = a*words + b from past renders so the
# director can hit the target duration on the first pass (no revision loop).
ENABLE_WPS_CALIBRATION=1
MIN_CALIBRATION_SAMPLES=3
# DIRECTOR_WPS_SLOPE=0.42   # override fitted seconds-per-word
# DIRECTOR_WPS_INTERCEPT=0.15  # override fitted intercept

# Cheap final encoding for static SVG scenes.
FINAL_ENCODER_PRESET=veryfast
STATIC_SCENE_FPS=12  # MUST match ANIM_SCENE_FPS; mixed fps breaks concat-copy timeline

# Streaming segment pipeline concurrency.
SCENE_WORKERS=2
MAX_ATTEMPTS_PER_SCENE=2

# ---------------------------------------------------------------------------
# Multi-key Groq pool (optional, real-time mode)
# GROQ_API_KEY is the primary key; add the rest here, comma-separated.
# Scenes are distributed across keys by per-minute token load; a key that
# returns 429 is quarantined until its minute resets and its scenes move to
# the next least-loaded key automatically.
# GROQ_API_KEYS=gsk_xxx,gsk_yyy,...
# GROQ_TPM_LIMIT=8000

# --- Object-level scene animation (phase 20) ---
# Enable/disable LLM-driven per-scene animation lists.
ANIM_ENABLED=1
# Max animation entries a scene may request from the LLM.
MAX_ANIMATIONS_PER_SCENE=16
# Frames per second used inside animated scenes (higher = smoother, more CPU).
ANIM_SCENE_FPS=12
# Hard cap on frames per scene (each frame = one SVG rasterization).
ANIM_MAX_FRAMES=240
STYLE_SKIN=default
CAPTIONS_ENABLED=1
CAPTIONS_FONT_SIZE=26
CAPTIONS_MAX_PHRASE_WORDS=14
MUSIC_TRACK_PATH=/home/ubuntu/simi_realtime/music_bed.mp3
MUSIC_VOLUME=0.10
VIDEO_ELEMENT_BUDGET=80
DOC_UPLOAD_DIR=./work/uploads

# Supabase server credentials. Keep the secret key backend-only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Stage 1 production safety. Development defaults to inline generation; a
# deployment must run the web process and worker.py as separate services.
APP_ENV=development
JOB_EXECUTION_MODE=inline
MAINTENANCE_MODE=0
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Production Compose pins the checksum-verified Lessac Piper voice. It does
# not inherit these host-specific development paths or allow silent fallback.
# Generate a unique 32+ character value in the deployment secret manager.
MEDIA_SIGNING_KEY=replace_with_a_long_random_value
ADMIN_USER_IDS=
MAX_UPLOAD_BYTES=10485760
MAX_PROMPT_CHARS=4000
MAX_VIDEO_DURATION_SECONDS=1800
GENERATION_RATE_LIMIT=10
GENERATION_RATE_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=30
WORKER_STALE_AFTER_SECONDS=300
WORKER_HEALTH_MAX_AGE_SECONDS=90
WEB_WORKERS=2
WEB_THREADS=4
WEB_TIMEOUT_SECONDS=120
LOG_FORMAT=json
LOG_LEVEL=INFO
APP_VERSION=development
RUN_LOGS_DIR=./work/logs/runs
ICON_CACHE_DIR=./work/icon_cache
VISUAL_PLANNING_MODE=hybrid

# These values are public and are embedded into the frontend at image build
# time. They are also configured as GitHub environment variables in Stage 2.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
VITE_PUBLIC_DEMO_URL=
VITE_PUBLIC_DEMO_POSTER_URL=
