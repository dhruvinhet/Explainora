# Copy to /opt/pencilvid/env/production.env and chmod 600.
# Never commit the populated file.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
MEDIA_SIGNING_KEY=
ALLOWED_ORIGINS=https://video.example.com
MAINTENANCE_MODE=0

# The production image and Compose definition pin the Lessac Piper voice.
# These tune that voice; the backend and model paths are deliberately not
# runtime-overridable so a release cannot silently change narrators.
TTS_SPEED_WPM=145
PIPER_LENGTH_SCALE=1.08
PIPER_COLD_START_WPM=178
PIPER_COLD_START_FEATURE_SCALE=0.67
TTS_VOICE=en-us

# Role-based production routing. This mirrors the development configuration:
# long-form strategy/script work uses Cerebras, while scene/visual planning
# and fast planning use Groq. LLM_PROVIDER is the fallback for unspecified
# roles; the two role overrides take precedence.
LLM_PROVIDER=groq
DIRECTOR_PROVIDER=cerebras
PLANNER_PROVIDER=groq

# Groq planner and key pool.
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DIRECTOR_MODEL=openai/gpt-oss-120b
GROQ_PLANNER_MODEL=openai/gpt-oss-120b
GROQ_FAST_PLANNER_MODEL=openai/gpt-oss-20b
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPD_LIMIT=200000
GROQ_TPM_SAFETY_TOKENS=300
GROQ_KEY_WAIT_MAX_SECONDS=70

# Cerebras long-form director and key pool.
CEREBRAS_API_KEY=
CEREBRAS_API_KEYS=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_DIRECTOR_MODEL=gpt-oss-120b
CEREBRAS_PLANNER_MODEL=gpt-oss-120b
CEREBRAS_FAST_PLANNER_MODEL=gpt-oss-120b
CEREBRAS_TIMEOUT_SECONDS=30
CEREBRAS_RPM_LIMIT=5
CEREBRAS_RPH_LIMIT=150
CEREBRAS_RPD_LIMIT=2400
CEREBRAS_KEY_WAIT_MAX_SECONDS=70

# Configured alternatives. They are not selected by the routing above but can
# be activated deliberately without rebuilding the image.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DIRECTOR_MODEL=openai/gpt-oss-120b
OPENROUTER_PLANNER_MODEL=qwen/qwen3.6-27b
OPENROUTER_HTTP_REFERER=https://video.example.com
OPENROUTER_APP_TITLE=Explainora

# Shared generation tuning used by both provider roles.
DIRECTOR_MAX_TOKENS=20000
DIRECTOR_MIN_TOKENS=8000
DIRECTOR_TOKENS_PER_NARRATION_WORD=12
DIRECTOR_PREFLIGHT_REPAIR_ATTEMPTS=2
VISUAL_MAX_TOKENS=6000
VISUAL_CONSTRAINED_MAX_TOKENS=2600
VISUAL_COMPACT_MAX_TOKENS=3600
DIRECTOR_REASONING_EFFORT=none
VISUAL_REASONING_EFFORT=none
PLAN_REVIEW_MODE=off
VISUAL_JSON_LLM_REPAIR_ENABLED=false
DIRECTOR_FACTUALITY_REPAIR_ATTEMPTS=1
DIRECTOR_FACTUALITY_LOCAL_FALLBACK=true
MAX_WORKERS=2
MAX_VISUAL_WORKERS=8
SCENE_WORKERS=8
TTS_WORKERS=4
VISUAL_GENERATION_RETRIES=3
VISUAL_PLANNING_MODE=hybrid

GENERATION_RATE_LIMIT=10
GENERATION_RATE_WINDOW_SECONDS=3600
PASSWORD_RESET_RATE_LIMIT=3
PASSWORD_RESET_RATE_WINDOW_SECONDS=3600
MAX_UPLOAD_BYTES=10485760
MAX_VIDEO_DURATION_SECONDS=1800
MAX_CONCURRENT_JOBS_PER_USER=1
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=30
WORKER_STALE_AFTER_SECONDS=300
WORKER_HEALTH_MAX_AGE_SECONDS=90
